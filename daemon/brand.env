# Значения переменных пакета client/jetboxbrand (патч 0003) для сборки службы JetBox.
# Читают scripts/build.sh (-ldflags -X) и scripts/test.sh (проверка, что -X дошли).
# Имена согласованы с core/platform и установщиками обеих платформ — менять только вместе с ними.
# Формат: <ОС|all> <Переменная>=<значение> (значение — до конца строки, пробелы допустимы).
all ServiceDisplayName=JetBox
all ServiceDescription=JetBox — подключение к вашему JetBox
all FirewallRuleName=JetBox
all NRPTKeyPrefix=JetBox-
all ScutilKeyPrefix=JetBox-
all WindowsDataDirName=JetBox
all UnixDataDir=/var/lib/jetbox
all PortMappingDescription=JetBox
windows ServiceName=JetBox
darwin ServiceName=net.jet-net.jetbox.daemon
all LegacyUnixConfigDir=/etc/jetbox/
all UnixLogDir=/var/log/jetbox/
all UnixRunDir=/var/run/jetbox
all DaemonAddrUnix=unix:///var/run/jetbox.sock
windows DaemonAddrWindows=npipe://jetbox
all MDMPlistPath=/Library/Managed Preferences/net.jet-net.jetbox.desktop.plist
all MDMRegistryPath=Software\Policies\JetBox
all SSHClientConfigFile=99-jetbox.conf
all DarwinLaunchdStdoutLog=/var/log/jetbox/daemon.out.log
all DarwinLaunchdStderrLog=/var/log/jetbox/daemon.err.log
all DefaultManagementURL=https://netbird.jet-net.net:443
all DefaultAdminURL=https://box.jet-net.net:443
