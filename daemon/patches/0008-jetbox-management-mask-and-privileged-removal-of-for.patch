+package server
+
+import (
+	"context"
+	"os"
+	"os/user"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/codes"
+	gstatus "google.golang.org/grpc/status"
+
+	"github.com/netbirdio/netbird/client/internal"
+	"github.com/netbirdio/netbird/client/internal/ipcauth"
+	"github.com/netbirdio/netbird/client/internal/profilemanager"
+	"github.com/netbirdio/netbird/client/proto"
+)
+
+// Upstream-тесты сервера не знают о проверке Г (вызывающий у них — выдуманный uid/SID без
+// имени); JetBox-тесты ниже включают её сами. Значение сборки запоминается до init.
+var builtProfileGate = jetboxProfileGate
+
+func init() { jetboxProfileGate = false }
+
+func TestJetboxProfileGateOnByDefault(t *testing.T) {
+	require.True(t, builtProfileGate, "в сборке JetBox проверка Г включена")
+}
+
+// withProfileGate включает проверку Г и называет обычного вызывающего userCtx() именем owner.
+func withProfileGate(t *testing.T, owner string) {
+	t.Helper()
+	prevGate, prevName := jetboxProfileGate, jetboxCallerName
+	jetboxProfileGate = true
+	jetboxCallerName = func(id ipcauth.Identity) (string, error) {
+		if id.SameUser(unprivilegedIdentity()) {
+			return owner, nil
+		}
+		return "someone-else-entirely", nil
+	}
+	t.Cleanup(func() { jetboxProfileGate, jetboxCallerName = prevGate, prevName })
+}
+
+// addInactiveProfile заводит профиль через AddProfile (как приложение при замене) — с меткой .added.
+func addInactiveProfile(t *testing.T, s *Server, username string) *profilemanager.Profile {
+	t.Helper()
+	resp, err := s.AddProfile(userCtx(), &proto.AddProfileRequest{ProfileName: "JetBox new", Username: username})
+	require.NoError(t, err)
+	p, err := s.profileManager.ResolveProfile(resp.GetId(), username)
+	require.NoError(t, err)
+	require.FileExists(t, jetboxProfileMark(p.Path, jetboxAddedSuffix))
+	// Ключ WG есть, а management недоступен: утечка мимо проверки упадёт быстро, без сети.
+	_, err = profilemanager.UpdateOrCreateConfig(profilemanager.ConfigInput{
+		ConfigPath:       p.Path,
+		ManagementURL:    unreachableManagementURL,
+		ServerSSHAllowed: boolPtr(false),
+	})
+	require.NoError(t, err)
+	return p
+}
+
+func removeCtx(t *testing.T, base context.Context) context.Context {
+	ctx, cancel := context.WithTimeout(base, 2*time.Second)
+	t.Cleanup(cancel)
+	return ctx
+}
+
+// Откат замены: свой новый профиль без регистрации приложение удаляет без прав.
+func TestJetboxRemoveOwnUnregisteredProfile(t *testing.T) {
+	s, _, _, username, _ := setupServerWithProfile(t)
+	withProfileGate(t, username)
+	p := addInactiveProfile(t, s, username)
+
+	_, err := s.RemoveProfile(removeCtx(t, userCtx()), &proto.RemoveProfileRequest{ProfileName: p.ID.String(), Username: username})
+	require.NoError(t, err)
+	require.NoFileExists(t, p.Path)
+	require.NoFileExists(t, jetboxProfileMark(p.Path, jetboxAddedSuffix), "метки удаляются вместе с профилем")
+}
+
+// Свой, но зарегистрированный и неактивный (остался после замены) — только с правами.
+func TestJetboxRemoveOwnRegisteredProfileNeedsPrivilege(t *testing.T) {
+	s, _, _, username, _ := setupServerWithProfile(t)
+	withProfileGate(t, username)
+	p := addInactiveProfile(t, s, username)
+	jetboxMarkProfileRegistered(&profilemanager.ActiveProfileState{ID: p.ID, Username: username})
+	require.FileExists(t, jetboxProfileMark(p.Path, jetboxRegisteredSuffix))
+
+	_, err := s.RemoveProfile(removeCtx(t, userCtx()), &proto.RemoveProfileRequest{ProfileName: p.ID.String(), Username: username})
+	assertDenied(t, err)
+	require.FileExists(t, p.Path, "отказ не трогает профиль")
+
+	// Администратор — можно (отвязка пира — best effort, адрес недоступен).
+	_, err = s.RemoveProfile(removeCtx(t, rootCtx()), &proto.RemoveProfileRequest{ProfileName: p.ID.String(), Username: username})
+	require.NoError(t, err)
+	require.NoFileExists(t, p.Path)
+	require.NoFileExists(t, jetboxProfileMark(p.Path, jetboxRegisteredSuffix))
+}
+
+// Профиль 1.0.5 (без меток) считается зарегистрированным.
+func TestJetboxRemoveLegacyProfileNeedsPrivilege(t *testing.T) {
+	s, _, _, username, _ := setupServerWithProfile(t)
+	withProfileGate(t, username)
+	legacy := "legacy-1-0-5"
+	path := filepath.Join(profilemanager.DefaultConfigPathDir, legacy+".json")
+	_, err := profilemanager.UpdateOrCreateConfig(profilemanager.ConfigInput{ConfigPath: path, ManagementURL: unreachableManagementURL})
+	require.NoError(t, err)
+
+	_, err = s.RemoveProfile(removeCtx(t, userCtx()), &proto.RemoveProfileRequest{ProfileName: legacy, Username: username})
+	assertDenied(t, err)
+	require.FileExists(t, path)
+}
+
+// Чужой профиль (пользователь в запросе — не вызывающий) — только с правами, даже без регистрации.
+func TestJetboxRemoveForeignProfileNeedsPrivilege(t *testing.T) {
+	s, _, _, username, _ := setupServerWithProfile(t)
+	withProfileGate(t, "another-user")
+	p := addInactiveProfile(t, s, username)
+
+	_, err := s.RemoveProfile(removeCtx(t, userCtx()), &proto.RemoveProfileRequest{ProfileName: p.ID.String(), Username: username})
+	assertDenied(t, err)
+	require.Contains(t, gstatus.Convert(err).Message(), "another user's profile")
+	require.FileExists(t, p.Path)
+
+	// Без учётных данных канала — тоже чужой (fail closed).
+	_, err = s.RemoveProfile(removeCtx(t, noIdentityCtx()), &proto.RemoveProfileRequest{ProfileName: p.ID.String(), Username: username})
+	assertDenied(t, err)
+
+	_, err = s.RemoveProfile(removeCtx(t, rootCtx()), &proto.RemoveProfileRequest{ProfileName: p.ID.String(), Username: username})
+	require.NoError(t, err)
+}
+
+// Имя пользователя сравнивается без учёта регистра (Windows: ДОМЕН\имя).
+func TestJetboxCallerIsUserCaseInsensitive(t *testing.T) {
+	withProfileGate(t, `PC\Alice`)
+	require.True(t, jetboxCallerIsUser(userCtx(), `pc\alice`))
+	require.False(t, jetboxCallerIsUser(userCtx(), `pc\bob`))
+	require.False(t, jetboxCallerIsUser(userCtx(), ""))
+	require.False(t, jetboxCallerIsUser(noIdentityCtx(), `pc\alice`))
+}
+
+// Успешный вход ставит метку профилю; default — нет (у него общий jetbox-registered).
+func TestJetboxProfileRegisteredMarks(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "abc.json")
+	require.True(t, jetboxProfileRegistered(path), "без меток — профиль до 1.0.6, считаем зарегистрированным")
+	jetboxWriteProfileMark(path, jetboxAddedSuffix)
+	require.False(t, jetboxProfileRegistered(path))
+	jetboxWriteProfileMark(path, jetboxRegisteredSuffix)
+	require.True(t, jetboxProfileRegistered(path))
+	jetboxRemoveProfileMarks(path)
+	entries, err := os.ReadDir(dir)
+	require.NoError(t, err)
+	require.Empty(t, entries)
+
+	jetboxMarkProfileRegistered(&profilemanager.ActiveProfileState{ID: profilemanager.DefaultProfileName})
+	jetboxMarkProfileAdded(&profilemanager.Profile{ID: profilemanager.DefaultProfileName, Path: path})
+	entries, err = os.ReadDir(dir)
+	require.NoError(t, err)
+	require.Empty(t, entries)
+}
+
+// Logout активного своего («Забыть коробку») — без прав, как раньше.
+func TestJetboxLogoutActiveOwnProfileAllowed(t *testing.T) {
+	s, _, activeProfile, username, cfgPath := setupServerWithProfile(t)
+	s.rootCtx = internal.CtxInitState(context.Background())
+	withProfileGate(t, username)
+	_, err := profilemanager.UpdateOrCreateConfig(profilemanager.ConfigInput{
+		ConfigPath:       cfgPath,
+		ManagementURL:    unreachableManagementURL,
+		ServerSSHAllowed: boolPtr(false),
+	})
+	require.NoError(t, err)
+
+	_, err = s.Logout(removeCtx(t, userCtx()), &proto.LogoutRequest{ProfileName: &activeProfile, Username: &username})
+	// Дальше проверки служба идёт отвязывать пир на недоступный адрес — это не отказ по правам.
+	require.Error(t, err)
+	require.NotEqual(t, codes.PermissionDenied, gstatus.Code(err), "свой активный — без прав: %v", err)
+}
+
+// Logout неактивного своего и чужого — только с правами.
+func TestJetboxLogoutInactiveOrForeignNeedsPrivilege(t *testing.T) {
+	s, _, _, username, _ := setupServerWithProfile(t)
+	s.rootCtx = internal.CtxInitState(context.Background())
+	withProfileGate(t, username)
+	p := addInactiveProfile(t, s, username)
+	id := p.ID.String()
+
+	_, err := s.Logout(removeCtx(t, userCtx()), &proto.LogoutRequest{ProfileName: &id, Username: &username})
+	assertDenied(t, err)
+	require.Contains(t, gstatus.Convert(err).Message(), "not active")
+
+	withProfileGate(t, "another-user")
+	_, err = s.Logout(removeCtx(t, userCtx()), &proto.LogoutRequest{ProfileName: &id, Username: &username})
+	assertDenied(t, err)
+
+	_, err = s.Logout(removeCtx(t, rootCtx()), &proto.LogoutRequest{ProfileName: &id, Username: &username})
+	require.Error(t, err, "адрес недоступен")
+	require.NotEqual(t, codes.PermissionDenied, gstatus.Code(err), "администратору можно: %v", err)
+}
+
+// Имя вызывающего — в той же форме, что user.Current().Username у приложения
+// (Unix — имя по uid, Windows — ДОМЕН\имя по SID).
+func TestJetboxCallerNameMatchesCurrentUser(t *testing.T) {
+	self, err := ipcauth.CurrentProcessIdentity()
+	require.NoError(t, err)
+	cur, err := user.Current()
+	require.NoError(t, err)
+	name, err := jetboxCallerNameOS(self)
+	require.NoError(t, err)
+	require.True(t, strings.EqualFold(cur.Username, name), "%q против %q", name, cur.Username)
+}
+
+// Logout без имени профиля отвязывает активный: SwitchProfile на чужой профиль и Logout{} —
+// только с правами. Свой активный и default (ничей) — без прав («Забыть коробку»).
+func TestJetboxLogoutActiveWithoutProfileName(t *testing.T) {
+	setup := func(t *testing.T, owner string, active profilemanager.ActiveProfileState) *Server {
+		s, _, _, _, cfgPath := setupServerWithProfile(t)
+		s.rootCtx = internal.CtxInitState(context.Background())
+		withProfileGate(t, owner)
+		path := cfgPath
+		if active.ID == profilemanager.DefaultProfileName {
+			path = profilemanager.DefaultConfigPath
+		}
+		_, err := profilemanager.UpdateOrCreateConfig(profilemanager.ConfigInput{
+			ConfigPath: path, ManagementURL: unreachableManagementURL, ServerSSHAllowed: boolPtr(false),
+		})
+		require.NoError(t, err)
+		require.NoError(t, s.profileManager.SetActiveProfileState(&active))
+		return s
+	}
+	notRefused := func(t *testing.T, err error) {
+		t.Helper()
+		// Дальше проверки служба идёт отвязывать пир на недоступный адрес — это не отказ по правам.
+		require.Error(t, err)
+		require.NotEqual(t, codes.PermissionDenied, gstatus.Code(err), "%v", err)
+	}
+
+	t.Run("чужой активный — только с правами", func(t *testing.T) {
+		s := setup(t, "eve", profilemanager.ActiveProfileState{ID: "test-profile-mdm", Username: "alice"})
+		_, err := s.Logout(removeCtx(t, userCtx()), &proto.LogoutRequest{})
+		assertDenied(t, err)
+		require.Contains(t, gstatus.Convert(err).Message(), "another user's profile")
+		require.Contains(t, gstatus.Convert(err).Message(), "jetboxd logout")
+		_, err = s.Logout(removeCtx(t, rootCtx()), &proto.LogoutRequest{})
+		notRefused(t, err)
+	})
+	t.Run("свой активный — без прав", func(t *testing.T) {
+		s := setup(t, "alice", profilemanager.ActiveProfileState{ID: "test-profile-mdm", Username: "ALICE"})
+		_, err := s.Logout(removeCtx(t, userCtx()), &proto.LogoutRequest{})
+		notRefused(t, err)
+	})
+	t.Run("default — ничей, без прав", func(t *testing.T) {
+		s := setup(t, "eve", profilemanager.ActiveProfileState{ID: profilemanager.DefaultProfileName})
+		_, err := s.Logout(removeCtx(t, userCtx()), &proto.LogoutRequest{})
+		notRefused(t, err)
+	})
+}
