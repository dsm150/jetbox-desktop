diff --git a/client/server/jetbox_mgmt_mask.go b/client/server/jetbox_mgmt_mask.go
new file mode 100644
index 0000000..12430ed
--- /dev/null
+++ b/client/server/jetbox_mgmt_mask.go
@@ -0,0 +1,83 @@
+package server
+
+import (
+	"context"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/netbirdio/netbird/client/internal/ipcauth"
+	"github.com/netbirdio/netbird/client/internal/profilemanager"
+	"github.com/netbirdio/netbird/client/jetboxbrand"
+)
+
+// JetBox: служба работает от root/SYSTEM и применяет маршруты, выход и DNS, которые раздаёт
+// management, для всей системы. Перевести её на чужой management обычный пользователь не
+// должен (docs/SERVICE-SOCKET-ACCESS.md, вариант Б): адрес вне *<AllowedManagementSuffix>
+// принимается только от привилегированного вызывающего. Пустой суффикс — апстрим.
+
+// jetboxManagementSuffix — переменная ради тестов; в сборке — значение -X.
+var jetboxManagementSuffix = func() string { return jetboxbrand.AllowedManagementSuffix }
+
+// jetboxManagementAllowed — адрес management в маске. Правило одно на все платформы JetBox
+// (LINK-CONTRACT §2.3, эталон — core/jetboxlink.AllowedManagement, общие векторы —
+// testdata/jetbox-mgmt-mask.json): https; без логина, пути (кроме «/»), query и фрагмента;
+// хост — ASCII-имя, не IP, оканчивается на суффикс (сам домен без поддомена — нет);
+// регистр и завершающая точка не важны; порт — любой 1–65535.
+func jetboxManagementAllowed(raw, suffix string) bool {
+	if suffix == "" {
+		return true
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "https" || u.User != nil || u.Opaque != "" {
+		return false
+	}
+	if u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || strings.Contains(raw, "#") {
+		return false
+	}
+	if u.Path != "" && u.Path != "/" {
+		return false
+	}
+	if strings.HasSuffix(u.Host, ":") { // «host:» — двоеточие без порта
+		return false
+	}
+	if p := u.Port(); p != "" {
+		n, err := strconv.Atoi(p)
+		if err != nil || n < 1 || n > 65535 {
+			return false
+		}
+	}
+	host := strings.TrimSuffix(strings.ToLower(u.Hostname()), ".")
+	if host == "" || net.ParseIP(host) != nil {
+		return false
+	}
+	for _, r := range host {
+		if !(r >= 'a' && r <= 'z' || r >= '0' && r <= '9' || r == '-' || r == '.') {
+			return false
+		}
+	}
+	for _, label := range strings.Split(host, ".") {
+		if label == "" {
+			return false
+		}
+	}
+	suffix = strings.ToLower(suffix)
+	return strings.HasSuffix(host, suffix) && len(host) > len(suffix)
+}
+
+// jetboxRequirePrivilegeForForeignManagement — часть requirePrivilegeForConfigChange: смена
+// management на адрес вне маски — только с правами, независимо от SSH. Повтор сохранённого
+// адреса (его мог поставить администратор) сменой не считается.
+func jetboxRequirePrivilegeForForeignManagement(ctx context.Context, stored *profilemanager.Config, change privilegedConfigChange) error {
+	suffix := jetboxManagementSuffix()
+	if change.managementURL == "" || jetboxManagementAllowed(change.managementURL, suffix) {
+		return nil
+	}
+	if stored != nil && sameManagementURL(stored.ManagementURL, change.managementURL) {
+		return nil
+	}
+	return denyPrivileged(ctx,
+		"connecting to a management server outside *"+suffix,
+		strings.ReplaceAll(ipcauth.UpCommand("-m "+change.managementURL), "netbird ", "jetboxd "))
+}
diff --git a/client/server/jetbox_mgmt_mask_test.go b/client/server/jetbox_mgmt_mask_test.go
new file mode 100644
index 0000000..dac1122
--- /dev/null
+++ b/client/server/jetbox_mgmt_mask_test.go
@@ -0,0 +1,162 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/codes"
+	gstatus "google.golang.org/grpc/status"
+
+	"github.com/netbirdio/netbird/client/internal"
+	"github.com/netbirdio/netbird/client/internal/profilemanager"
+	"github.com/netbirdio/netbird/client/jetboxbrand"
+	"github.com/netbirdio/netbird/client/proto"
+)
+
+const jetboxTestSuffix = ".jet-net.net"
+
+// withManagementSuffix включает маску на время теста (в upstream-тестах суффикс пуст — апстрим).
+func withManagementSuffix(t *testing.T, suffix string) {
+	t.Helper()
+	prev := jetboxManagementSuffix
+	jetboxManagementSuffix = func() string { return suffix }
+	t.Cleanup(func() { jetboxManagementSuffix = prev })
+}
+
+// Общие векторы маски — копия core/jetboxlink/testdata/mgmt-mask.json репозитория JetBox
+// (daemon/scripts/test.sh сверяет, что копия не разошлась).
+func TestJetboxManagementMaskVectors(t *testing.T) {
+	raw, err := os.ReadFile(filepath.Join("testdata", "jetbox-mgmt-mask.json"))
+	require.NoError(t, err)
+	var v struct {
+		Suffix string `json:"suffix"`
+		Cases  []struct {
+			M   string `json:"m"`
+			OK  bool   `json:"ok"`
+			Why string `json:"why"`
+		} `json:"cases"`
+	}
+	require.NoError(t, json.Unmarshal(raw, &v))
+	require.Equal(t, jetboxTestSuffix, v.Suffix)
+	require.GreaterOrEqual(t, len(v.Cases), 30, "файл векторов обрезан?")
+	for _, c := range v.Cases {
+		if got := jetboxManagementAllowed(c.M, v.Suffix); got != c.OK {
+			t.Errorf("%q (%s): %v, ждали %v", c.M, c.Why, got, c.OK)
+		}
+	}
+	// Значение нового профиля в сборке JetBox — в маске.
+	require.True(t, jetboxManagementAllowed("https://netbird.jet-net.net:443", jetboxTestSuffix))
+}
+
+func TestJetboxManagementMaskEmptySuffixIsUpstream(t *testing.T) {
+	require.True(t, jetboxManagementAllowed("https://api.netbird.io:443", ""))
+	require.True(t, jetboxManagementAllowed("http://1.2.3.4", ""))
+	if os.Getenv("JETBOX_BRAND_EXPECT") == "" {
+		require.Empty(t, jetboxbrand.AllowedManagementSuffix, "без -X маски нет")
+	}
+}
+
+// Маска проверяется до правила «SSH включён» и независимо от него.
+func TestJetboxForeignManagementGate(t *testing.T) {
+	withManagementSuffix(t, jetboxTestSuffix)
+	ours := mustURL(t, "https://netbird.jet-net.net:443")
+	foreign := mustURL(t, "https://evil.example:443")
+	sshOff := &profilemanager.Config{ManagementURL: ours, ServerSSHAllowed: boolPtr(false)}
+	sshOn := &profilemanager.Config{ManagementURL: ours, ServerSSHAllowed: boolPtr(true)}
+
+	for name, stored := range map[string]*profilemanager.Config{"нет конфига": nil, "SSH выкл": sshOff, "SSH вкл": sshOn} {
+		t.Run(name, func(t *testing.T) {
+			err := requirePrivilegeForConfigChange(userCtx(), stored, privilegedConfigChange{managementURL: "https://evil.example"})
+			assertDenied(t, err)
+			require.Contains(t, gstatus.Convert(err).Message(), "outside *.jet-net.net")
+			assertAllowed(t, requirePrivilegeForConfigChange(rootCtx(), stored, privilegedConfigChange{managementURL: "https://evil.example"}))
+		})
+	}
+	// Без учётных данных канала — отказ (fail closed).
+	assertDenied(t, requirePrivilegeForConfigChange(noIdentityCtx(), sshOff, privilegedConfigChange{managementURL: "https://1.2.3.4"}))
+	// В маске — без прав (при выключенном SSH).
+	assertAllowed(t, requirePrivilegeForConfigChange(userCtx(), sshOff, privilegedConfigChange{managementURL: "https://box2.jet-net.net:33073"}))
+	assertAllowed(t, requirePrivilegeForConfigChange(userCtx(), nil, privilegedConfigChange{managementURL: "https://netbird.jet-net.net"}))
+	// Без смены management маска не мешает.
+	assertAllowed(t, requirePrivilegeForConfigChange(userCtx(), sshOff, privilegedConfigChange{}))
+	// Сохранённый чужой адрес (его поставил администратор) повторить можно, сменить на другой чужой — нет.
+	adminSet := &profilemanager.Config{ManagementURL: foreign, ServerSSHAllowed: boolPtr(false)}
+	assertAllowed(t, requirePrivilegeForConfigChange(userCtx(), adminSet, privilegedConfigChange{managementURL: "https://evil.example"}))
+	assertDenied(t, requirePrivilegeForConfigChange(userCtx(), adminSet, privilegedConfigChange{managementURL: "https://other.example"}))
+}
+
+func TestJetboxSetConfigForeignManagement(t *testing.T) {
+	withManagementSuffix(t, jetboxTestSuffix)
+	s, _, profName, username, cfgPath := setupServerWithProfile(t)
+	_, err := profilemanager.UpdateOrCreateConfig(profilemanager.ConfigInput{
+		ConfigPath:       cfgPath,
+		ManagementURL:    "https://netbird.jet-net.net:443",
+		ServerSSHAllowed: boolPtr(false),
+	})
+	require.NoError(t, err)
+	req := func(m string) *proto.SetConfigRequest {
+		return &proto.SetConfigRequest{ProfileName: profName, Username: username, ManagementUrl: m}
+	}
+	stored := func() string {
+		c, err := profilemanager.GetExistingConfig(cfgPath)
+		require.NoError(t, err)
+		return c.ManagementURL.String()
+	}
+
+	_, err = s.SetConfig(userCtx(), req("https://evil.example:443"))
+	assertDenied(t, err)
+	require.Equal(t, "https://netbird.jet-net.net:443", stored(), "отказ не должен менять профиль")
+
+	_, err = s.SetConfig(userCtx(), req("https://box2.jet-net.net:443"))
+	require.NoError(t, err)
+	require.Equal(t, "https://box2.jet-net.net:443", stored())
+
+	_, err = s.SetConfig(rootCtx(), req("https://evil.example:443"))
+	require.NoError(t, err, "администратор может всё")
+	require.Equal(t, "https://evil.example:443", stored())
+}
+
+func TestJetboxLoginForeignManagement(t *testing.T) {
+	withManagementSuffix(t, jetboxTestSuffix)
+	s, _, activeProfile, username, _ := setupServerWithProfile(t)
+	s.rootCtx = internal.CtxInitState(context.Background())
+
+	target := "jetbox-target"
+	targetPath := filepath.Join(profilemanager.DefaultConfigPathDir, target+".json")
+	_, err := profilemanager.UpdateOrCreateConfig(profilemanager.ConfigInput{
+		ConfigPath:       targetPath,
+		ManagementURL:    "https://netbird.jet-net.net:443",
+		ServerSSHAllowed: boolPtr(false),
+	})
+	require.NoError(t, err)
+
+	// Обычный пользователь: отказ до любых действий — профиль не переключён, адрес не тронут.
+	_, err = s.Login(userCtx(), &proto.LoginRequest{
+		ProfileName: &target, Username: &username, SetupKey: "key", ManagementUrl: unreachableManagementURL,
+	})
+	assertDenied(t, err)
+	active, err := s.profileManager.GetActiveProfileState()
+	require.NoError(t, err)
+	require.Equal(t, profilemanager.ID(activeProfile), active.ID)
+	c, err := profilemanager.GetExistingConfig(targetPath)
+	require.NoError(t, err)
+	require.Equal(t, "https://netbird.jet-net.net:443", c.ManagementURL.String())
+
+	// Администратор проходит проверку; дальше вход упирается в недоступный адрес — но не в права.
+	ctx, cancel := context.WithTimeout(rootCtx(), 3*time.Second)
+	t.Cleanup(cancel)
+	_, err = s.Login(ctx, &proto.LoginRequest{
+		ProfileName: &target, Username: &username, SetupKey: "key", ManagementUrl: unreachableManagementURL,
+	})
+	require.Error(t, err)
+	require.NotEqual(t, codes.PermissionDenied, gstatus.Code(err), "администратора не должна останавливать маска: %v", err)
+	c, err = profilemanager.GetExistingConfig(targetPath)
+	require.NoError(t, err)
+	require.True(t, strings.HasPrefix(c.ManagementURL.String(), "https://127.0.0.1:9"), "адрес администратора записан: %s", c.ManagementURL)
+}
diff --git a/client/server/jetbox_profile_gate.go b/client/server/jetbox_profile_gate.go
new file mode 100644
index 0000000..ae04a42
--- /dev/null
+++ b/client/server/jetbox_profile_gate.go
@@ -0,0 +1,186 @@
+package server
+
+import (
+	"context"
+	"os"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+	"google.golang.org/grpc/codes"
+	gstatus "google.golang.org/grpc/status"
+
+	"github.com/netbirdio/netbird/client/internal/ipcauth"
+	"github.com/netbirdio/netbird/client/internal/profilemanager"
+)
+
+// JetBox: отвязать пир и удалить профиль, который не принадлежит вызывающему или уже
+// зарегистрирован и не активен, может только администратор (docs/SERVICE-SOCKET-ACCESS.md,
+// вариант Г). Так служебный профиль (или профиль другого пользователя ОС) не снять обычной
+// программой, а откат замены подключения в приложении — удаление своего нового профиля, вход
+// в который не удался, — работает без прав.
+//
+// «Свой» — пользователь профиля (Username запроса: по нему служба выбирает каталог профилей)
+// совпадает с вызывающим по учётным данным канала: Unix — имя по uid, Windows — ДОМЕН\имя по
+// SID; без учёта регистра. Профиль default — ничей: свой для всех (удалить его служба не даёт).
+//
+// «Зарегистрирован» — метки рядом с файлом профиля:
+//   - <id>.registered — успешный Login в этот профиль;
+//   - <id>.added — профиль заведён AddProfile службой, которая ведёт метки (с 1.0.6).
+// Профиль без <id>.added заведён раньше — о его регистрации ничего не известно, считаем
+// зарегистрированным (решение руководителя 18.11.2026: бережёт служебные профили 1.0.5).
+
+const (
+	jetboxRegisteredSuffix = ".registered"
+	jetboxAddedSuffix      = ".added"
+)
+
+// jetboxProfileGate — переменная ради upstream-тестов сервера (jetbox_profile_gate_test.go).
+var jetboxProfileGate = true
+
+// jetboxCallerName — имя пользователя ОС вызывающего; переменная ради тестов.
+var jetboxCallerName = jetboxCallerNameOS
+
+type jetboxProfileOp int
+
+const (
+	jetboxOpRemove jetboxProfileOp = iota
+	jetboxOpLogout
+)
+
+// jetboxProfileMark — путь метки рядом с файлом профиля (<каталог>/<id><suffix>).
+func jetboxProfileMark(cfgPath, suffix string) string {
+	if cfgPath == "" {
+		return ""
+	}
+	return strings.TrimSuffix(cfgPath, ".json") + suffix
+}
+
+func jetboxWriteProfileMark(cfgPath, suffix string) {
+	p := jetboxProfileMark(cfgPath, suffix)
+	if p == "" {
+		return
+	}
+	if err := os.WriteFile(p, []byte("1\n"), 0o600); err != nil {
+		log.Warnf("profile mark %s: %v", p, err)
+	}
+}
+
+func jetboxRemoveProfileMarks(cfgPath string) {
+	for _, suffix := range []string{jetboxRegisteredSuffix, jetboxAddedSuffix} {
+		if p := jetboxProfileMark(cfgPath, suffix); p != "" {
+			if err := os.Remove(p); err != nil && !os.IsNotExist(err) {
+				log.Warnf("remove profile mark %s: %v", p, err)
+			}
+		}
+	}
+}
+
+func jetboxMarkExists(cfgPath, suffix string) bool {
+	p := jetboxProfileMark(cfgPath, suffix)
+	if p == "" {
+		return false
+	}
+	_, err := os.Stat(p)
+	return err == nil
+}
+
+// jetboxProfileRegistered — была ли у профиля регистрация (см. выше); без меток — да.
+func jetboxProfileRegistered(cfgPath string) bool {
+	return jetboxMarkExists(cfgPath, jetboxRegisteredSuffix) || !jetboxMarkExists(cfgPath, jetboxAddedSuffix)
+}
+
+// jetboxMarkProfileAdded — AddProfile: профиль заведён этой службой, регистрации пока нет.
+func jetboxMarkProfileAdded(p *profilemanager.Profile) {
+	if p == nil || p.ID == profilemanager.DefaultProfileName {
+		return
+	}
+	jetboxWriteProfileMark(p.Path, jetboxAddedSuffix)
+}
+
+// jetboxMarkProfileRegistered — успешный вход в профиль active (у default признак — общий
+// jetbox-registered).
+func jetboxMarkProfileRegistered(active *profilemanager.ActiveProfileState) {
+	if active == nil || active.ID == profilemanager.DefaultProfileName {
+		return
+	}
+	cfgPath, err := active.FilePath()
+	if err != nil {
+		log.Warnf("profile mark: %v", err)
+		return
+	}
+	jetboxWriteProfileMark(cfgPath, jetboxRegisteredSuffix)
+}
+
+// jetboxCallerIsUser — вызывающий и есть пользователь ОС username. Без учётных данных
+// канала или имени — нет (fail closed: решит denyPrivileged).
+func jetboxCallerIsUser(ctx context.Context, username string) bool {
+	if username == "" {
+		return false
+	}
+	id, ok := ipcauth.CallerIdentity(ctx)
+	if !ok {
+		return false
+	}
+	name, err := jetboxCallerName(id)
+	if err != nil {
+		log.Debugf("caller name for %s: %v", id, err)
+		return false
+	}
+	return name != "" && strings.EqualFold(name, username)
+}
+
+// requirePrivilegeForForeignProfile — проверка прав для RemoveProfile и Logout с ProfileName.
+// username — пользователь профиля из запроса, active — профиль сейчас активен.
+//
+//   - RemoveProfile: свой незарегистрированный — без прав; чужой или зарегистрированный — только
+//     с правами (активный служба всё равно не удалит, но апстрим до отказа успел бы снять его пир
+//     с учёта);
+//   - Logout: свой активный — без прав (как `netbird logout`: «Забыть коробку»); неактивный или
+//     чужой — только с правами.
+func requirePrivilegeForForeignProfile(ctx context.Context, op jetboxProfileOp, profile *profilemanager.Profile, username string, active bool) error {
+	if !jetboxProfileGate || profile == nil {
+		return nil
+	}
+	isDefault := profile.ID == profilemanager.DefaultProfileName
+	own := isDefault || jetboxCallerIsUser(ctx, username)
+	name := profile.ID.String()
+
+	switch op {
+	case jetboxOpRemove:
+		if isDefault {
+			return nil // default не удаляется — отказ апстрима
+		}
+		cfgPath := profile.Path
+		if own && !jetboxProfileRegistered(cfgPath) {
+			return nil
+		}
+		action := "removing a registered profile"
+		if !own {
+			action = "removing another user's profile"
+		}
+		return denyPrivileged(ctx, action, ipcauth.ElevatedCommand("jetboxd profile remove "+name))
+	case jetboxOpLogout:
+		if own && active {
+			return nil
+		}
+		action := "deregistering a profile that is not active"
+		if !own {
+			action = "deregistering another user's profile"
+		}
+		return denyPrivileged(ctx, action, ipcauth.ElevatedCommand("jetboxd logout --profile "+name))
+	}
+	return nil
+}
+
+// jetboxRequirePrivilegeForActiveLogout — Logout без имени профиля отвязывает активный: та же
+// проверка, что у Logout с ProfileName активного профиля (пользователь — из состояния активного).
+func (s *Server) jetboxRequirePrivilegeForActiveLogout(ctx context.Context) error {
+	if !jetboxProfileGate {
+		return nil
+	}
+	active, err := s.profileManager.GetActiveProfileState()
+	if err != nil {
+		return gstatus.Errorf(codes.FailedPrecondition, "failed to get active profile state: %v", err)
+	}
+	return requirePrivilegeForForeignProfile(ctx, jetboxOpLogout, &profilemanager.Profile{ID: active.ID}, active.Username, true)
+}
diff --git a/client/server/jetbox_profile_gate_test.go b/client/server/jetbox_profile_gate_test.go
