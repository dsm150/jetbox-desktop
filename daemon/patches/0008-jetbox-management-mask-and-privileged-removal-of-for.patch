+//go:build !windows
+
+package server
+
+import (
+	"os/user"
+	"strconv"
+
+	"github.com/netbirdio/netbird/client/internal/ipcauth"
+)
+
+// jetboxCallerNameOS — имя пользователя по uid вызывающего, как его берёт приложение
+// (user.Current().Username). Без записи о пользователе — число uid: так же поступает
+// profilemanager.InvokingUser.
+func jetboxCallerNameOS(id ipcauth.Identity) (string, error) {
+	uid := strconv.FormatUint(uint64(id.UID), 10)
+	u, err := user.LookupId(uid)
+	if err != nil {
+		if _, unknown := err.(user.UnknownUserIdError); unknown {
+			return uid, nil
+		}
+		return "", err
+	}
+	return u.Username, nil
+}
