+//go:build windows
+
+package server
+
+import (
+	"fmt"
+
+	"golang.org/x/sys/windows"
+
+	"github.com/netbirdio/netbird/client/internal/ipcauth"
+)
+
+// jetboxCallerNameOS — ДОМЕН\имя по SID вызывающего (LookupAccountSid), в той же форме, что
+// user.Current().Username у приложения.
+func jetboxCallerNameOS(id ipcauth.Identity) (string, error) {
+	if id.SID == "" {
+		return "", fmt.Errorf("caller has no SID")
+	}
+	sid, err := windows.StringToSid(id.SID)
+	if err != nil {
+		return "", fmt.Errorf("parse SID %s: %w", id.SID, err)
+	}
+	account, domain, _, err := sid.LookupAccount("")
+	if err != nil {
+		return "", fmt.Errorf("lookup SID %s: %w", id.SID, err)
+	}
+	if domain == "" {
+		return account, nil
+	}
+	return domain + `\` + account, nil
+}
