+package device
+
+import (
+	"os"
+	"testing"
+)
+
+// daemon/scripts/test.sh передаёт ожидаемый GUID адаптера Windows (JETBOX_EXPECT_GUID) вместе
+// с теми же -ldflags, что и сборка: опечатку в пути -X линкер молча пропускает.
+func TestJetboxWindowsGUIDFlag(t *testing.T) {
+	want := os.Getenv("JETBOX_EXPECT_GUID")
+	if want == "" {
+		t.Skip("нет JETBOX_EXPECT_GUID")
+	}
+	if CustomWindowsGUIDString != want {
+		t.Fatalf("CustomWindowsGUIDString = %q, ждали %q (путь -X не тот?)", CustomWindowsGUIDString, want)
+	}
+}
