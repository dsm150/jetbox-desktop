@@ -0,0 +1,70 @@
+// Package jetboxbrand собирает в одном месте имена, которые служба оставляет в системе
+// и которые видны пользователю или сталкиваются с установленным рядом официальным NetBird.
+//
+// Значения по умолчанию — ровно апстримовские: без флагов сборки поведение не меняется.
+// Сборка JetBox задаёт их через
+//
+//	-ldflags "-X github.com/netbirdio/netbird/client/jetboxbrand.<Имя>=<значение>"
+//
+// (см. daemon/JETBOX-BUILD.md). Только строки — так требует -X.
+package jetboxbrand
+
+var (
+	// ServiceName — имя системной службы по умолчанию для `service …` (Windows — ключ службы,
+	// macOS — label launchd). Пусто — апстрим: «Netbird» на Windows, «netbird» на остальных.
+	ServiceName = ""
+	// ServiceDisplayName — отображаемое имя службы (Windows «Службы»).
+	ServiceDisplayName = "Netbird"
+	// ServiceDescription — описание службы.
+	ServiceDescription = "NetBird mesh network client"
+
+	// FirewallRuleName — имя правила брандмауэра Windows для интерфейса (+ «-v6»).
+	FirewallRuleName = "Netbird"
+	// NRPTKeyPrefix — префикс ключей NRPT (DNS-правила Windows); уборка удаляет всё с этим префиксом.
+	NRPTKeyPrefix = "NetBird-"
+	// ScutilKeyPrefix — префикс ключей State:/Network/Service/<префикс>… в scutil (DNS macOS);
+	// уборка удаляет всё с этим префиксом.
+	ScutilKeyPrefix = "NetBird-"
+
+	// WindowsDataDirName — каталог в %ProgramData% по умолчанию: состояние без NB_STATE_DIR,
+	// лог паники, tmp-install.
+	WindowsDataDirName = "Netbird"
+	// UnixDataDir — каталог состояния по умолчанию на macOS/Linux (без NB_STATE_DIR), tmp-install.
+	UnixDataDir = "/var/lib/netbird"
+
+	// PortMappingDescription — описание проброса порта UPnP/NAT-PMP на роутере.
+	PortMappingDescription = "NetBird"
+
+	// LegacyUnixConfigDir — старый каталог конфига на macOS/Linux. Служба при первом старте
+	// копирует оттуда config.json в свой профиль, CLI держит там конфиг по умолчанию.
+	// Для JetBox — свой (несуществующий) каталог: иначе служба подхватит ключ и management
+	// официального NetBird, стоявшего на этом компьютере.
+	LegacyUnixConfigDir = "/etc/netbird/"
+	// UnixLogDir — каталог логов CLI по умолчанию на macOS/Linux.
+	UnixLogDir = "/var/log/netbird/"
+	// UnixRunDir — где CLI ищет сокет службы, если сокета по умолчанию нет.
+	UnixRunDir = "/var/run/netbird"
+	// DaemonAddrUnix — канал службы по умолчанию для CLI на macOS/Linux.
+	DaemonAddrUnix = "unix:///var/run/netbird.sock"
+	// DaemonAddrWindows — канал службы по умолчанию для CLI на Windows; пусто — апстрим.
+	DaemonAddrWindows = ""
+
+	// MDMPlistPath — управляемые настройки macOS (MDM), применяются службой последним слоем.
+	MDMPlistPath = "/Library/Managed Preferences/io.netbird.client.plist"
+	// MDMRegistryPath — то же для Windows (HKLM).
+	MDMRegistryPath = `Software\Policies\NetBird`
+
+	// SSHClientConfigFile — файл в /etc/ssh/ssh_config.d (и аналоге Windows), который служба
+	// пишет и удаляет при остановке.
+	SSHClientConfigFile = "99-netbird.conf"
+
+	// DarwinLaunchdStdoutLog и DarwinLaunchdStderrLog — логи stdout/stderr службы под launchd,
+	// которые собирает отладочный пакет.
+	DarwinLaunchdStdoutLog = "/var/log/netbird.out.log"
+	DarwinLaunchdStderrLog = "/var/log/netbird.err.log"
+
+	// DefaultManagementURL и DefaultAdminURL — адреса, которые служба пишет в новый профиль, пока
+	// приложение не передало свой (Login{managementUrl}).
+	DefaultManagementURL = "https://api.netbird.io:443"
+	DefaultAdminURL      = "https://app.netbird.io:443"
+)
diff --git a/client/jetboxbrand/brand_test.go b/client/jetboxbrand/brand_test.go
new file mode 100644
index 0000000..ca53f09
--- /dev/null
+++ b/client/jetboxbrand/brand_test.go
@@ -0,0 +1,96 @@
+package jetboxbrand
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func current() map[string]string {
+	return map[string]string{
+		"ServiceName":            ServiceName,
+		"ServiceDisplayName":     ServiceDisplayName,
+		"ServiceDescription":     ServiceDescription,
+		"FirewallRuleName":       FirewallRuleName,
+		"NRPTKeyPrefix":          NRPTKeyPrefix,
+		"ScutilKeyPrefix":        ScutilKeyPrefix,
+		"WindowsDataDirName":     WindowsDataDirName,
+		"UnixDataDir":            UnixDataDir,
+		"PortMappingDescription": PortMappingDescription,
+		"LegacyUnixConfigDir":    LegacyUnixConfigDir,
+		"UnixLogDir":             UnixLogDir,
+		"UnixRunDir":             UnixRunDir,
+		"DaemonAddrUnix":         DaemonAddrUnix,
+		"DaemonAddrWindows":      DaemonAddrWindows,
+		"MDMPlistPath":           MDMPlistPath,
+		"MDMRegistryPath":        MDMRegistryPath,
+		"SSHClientConfigFile":    SSHClientConfigFile,
+		"DarwinLaunchdStdoutLog": DarwinLaunchdStdoutLog,
+		"DarwinLaunchdStderrLog": DarwinLaunchdStderrLog,
+		"DefaultManagementURL":   DefaultManagementURL,
+		"DefaultAdminURL":        DefaultAdminURL,
+	}
+}
+
+// Без флагов сборки — ровно апстрим (патч не меняет поведение NetBird сам по себе).
+func TestDefaultsAreUpstream(t *testing.T) {
+	if os.Getenv("JETBOX_BRAND_EXPECT") != "" {
+		t.Skip("сборка с -X: проверяет TestBuildValues")
+	}
+	want := map[string]string{
+		"ServiceName":            "",
+		"ServiceDisplayName":     "Netbird",
+		"ServiceDescription":     "NetBird mesh network client",
+		"FirewallRuleName":       "Netbird",
+		"NRPTKeyPrefix":          "NetBird-",
+		"ScutilKeyPrefix":        "NetBird-",
+		"WindowsDataDirName":     "Netbird",
+		"UnixDataDir":            "/var/lib/netbird",
+		"PortMappingDescription": "NetBird",
+		"LegacyUnixConfigDir":    "/etc/netbird/",
+		"UnixLogDir":             "/var/log/netbird/",
+		"UnixRunDir":             "/var/run/netbird",
+		"DaemonAddrUnix":         "unix:///var/run/netbird.sock",
+		"DaemonAddrWindows":      "",
+		"MDMPlistPath":           "/Library/Managed Preferences/io.netbird.client.plist",
+		"MDMRegistryPath":        `Software\Policies\NetBird`,
+		"SSHClientConfigFile":    "99-netbird.conf",
+		"DarwinLaunchdStdoutLog": "/var/log/netbird.out.log",
+		"DarwinLaunchdStderrLog": "/var/log/netbird.err.log",
+		"DefaultManagementURL":   "https://api.netbird.io:443",
+		"DefaultAdminURL":        "https://app.netbird.io:443",
+	}
+	for k, v := range want {
+		if got := current()[k]; got != v {
+			t.Errorf("%s = %q, апстрим %q", k, got, v)
+		}
+	}
+}
+
+// daemon/scripts/test.sh гоняет пакет с теми же -X, что и сборка, и передаёт ожидание
+// в JETBOX_BRAND_EXPECT («Имя=значение» через перевод строки). Опечатка в пути -X
+// линкер молча пропускает — этот тест её ловит.
+func TestBuildValues(t *testing.T) {
+	exp := os.Getenv("JETBOX_BRAND_EXPECT")
+	if exp == "" {
+		t.Skip("нет JETBOX_BRAND_EXPECT")
+	}
+	cur := current()
+	for _, line := range strings.Split(exp, "\n") {
+		if line = strings.TrimSpace(line); line == "" {
+			continue
+		}
+		k, v, ok := strings.Cut(line, "=")
+		if !ok {
+			t.Fatalf("плохая строка ожидания %q", line)
+		}
+		got, known := cur[k]
+		if !known {
+			t.Errorf("неизвестная переменная %s", k)
+			continue
+		}
+		if got != v {
+			t.Errorf("%s = %q, ждали %q (путь -X не тот?)", k, got, v)
+		}
+	}
+}
