index 0000000..78900ce
--- /dev/null
+++ b/client/internal/dns/jetbox_scutil_darwin_test.go
@@ -0,0 +1,22 @@
+//go:build !ios
+
+package dns
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/netbirdio/netbird/client/jetboxbrand"
+)
+
+// Ключи DNS в scutil строятся от префикса сборки — чтобы служба JetBox не писала в ключи
+// официального NetBird и не удаляла их при уборке.
+func TestJetboxScutilKeysUseBrandPrefix(t *testing.T) {
+	p := jetboxbrand.ScutilKeyPrefix
+	if got := getKeyWithInput(netbirdDNSStateKeyFormat, matchSuffix); got != "State:/Network/Service/"+p+"Match/DNS" {
+		t.Errorf("ключ match: %q", got)
+	}
+	if got := strings.Count(netbirdDNSStateKeyIndexedFormat, p); got != 1 {
+		t.Errorf("индексированный формат без префикса: %q", netbirdDNSStateKeyIndexedFormat)
+	}
+}
