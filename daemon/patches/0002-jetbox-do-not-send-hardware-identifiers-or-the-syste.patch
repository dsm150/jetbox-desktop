+// JetBox («аппаратных идентификаторов не собираем»).
+const jetboxCollectHardwareIDs = false
diff --git a/client/system/jetbox_privacy_test.go b/client/system/jetbox_privacy_test.go
new file mode 100644
index 0000000..30db2a1
--- /dev/null
+++ b/client/system/jetbox_privacy_test.go
@@ -0,0 +1,25 @@
+//go:build (darwin && !ios) || windows || (linux && !android)
+
+package system
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestJetboxNoHardwareIDsInStaticInfo(t *testing.T) {
+	si := newStaticInfo()
+	assert.Empty(t, si.SystemSerialNumber, "серийный номер не должен собираться")
+	assert.Empty(t, si.SystemProductName, "модель не должна собираться")
+	assert.Empty(t, si.SystemManufacturer, "производитель не должен собираться")
+}
+
+func TestJetboxNoMACInNetworkAddresses(t *testing.T) {
+	addrs, err := networkAddresses()
+	assert.NoError(t, err)
+	for _, a := range addrs {
+		assert.Empty(t, a.Mac, "MAC не должен уходить на management (%s)", a.NetIP)
+	}
+	t.Logf("адресов: %d", len(addrs))
+}
