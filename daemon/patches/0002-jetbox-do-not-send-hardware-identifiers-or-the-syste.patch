diff --git a/client/system/jetbox_device_name.go b/client/system/jetbox_device_name.go
new file mode 100644
index 0000000..be5b260
--- /dev/null
+++ b/client/system/jetbox_device_name.go
@@ -0,0 +1,69 @@
+package system
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	log "github.com/sirupsen/logrus"
+
+	"github.com/netbirdio/netbird/client/configs"
+)
+
+// JetBox: системное имя компьютера (os.Hostname — обычно «MacBook-Air-<Имя>», имя ПК Windows)
+// на management не уходит. Имя устройства — только то, что приложение передало в Login/Up
+// (`hostname`); служба запоминает его в каталоге состояния, чтобы и после перезапуска в
+// метаданных было оно, а не системное. Ни разу не задано — нейтральное jetboxFallbackDeviceName.
+const (
+	jetboxDeviceNameFile     = "jetbox-device-name"
+	jetboxFallbackDeviceName = "JetBox"
+)
+
+var (
+	jetboxDeviceNameMu     sync.Mutex
+	jetboxDeviceNameLoaded bool
+	jetboxDeviceName       string
+	// jetboxStateDir — каталог, где лежит имя; переменная ради тестов.
+	jetboxStateDir = func() string { return configs.StateDir }
+)
+
+// SetDeviceName запоминает имя устройства, переданное приложением в Login/Up.
+func SetDeviceName(name string) {
+	name = strings.TrimSpace(name)
+	if name == "" {
+		return
+	}
+	jetboxDeviceNameMu.Lock()
+	defer jetboxDeviceNameMu.Unlock()
+	jetboxDeviceName, jetboxDeviceNameLoaded = name, true
+	dir := jetboxStateDir()
+	if dir == "" {
+		return
+	}
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		log.Warnf("save device name: %v", err)
+		return
+	}
+	if err := os.WriteFile(filepath.Join(dir, jetboxDeviceNameFile), []byte(name), 0o600); err != nil {
+		log.Warnf("save device name: %v", err)
+	}
+}
+
+// deviceNameFallback — имя устройства, когда в контексте вызова его нет.
+func deviceNameFallback() string {
+	jetboxDeviceNameMu.Lock()
+	defer jetboxDeviceNameMu.Unlock()
+	if !jetboxDeviceNameLoaded {
+		jetboxDeviceNameLoaded = true
+		if dir := jetboxStateDir(); dir != "" {
+			if b, err := os.ReadFile(filepath.Join(dir, jetboxDeviceNameFile)); err == nil {
+				jetboxDeviceName = strings.TrimSpace(string(b))
+			}
+		}
+	}
+	if jetboxDeviceName != "" {
+		return jetboxDeviceName
+	}
+	return jetboxFallbackDeviceName
+}
diff --git a/client/system/jetbox_device_name_test.go b/client/system/jetbox_device_name_test.go
new file mode 100644
index 0000000..fc2b97a
--- /dev/null
+++ b/client/system/jetbox_device_name_test.go
@@ -0,0 +1,58 @@
+//go:build (darwin && !ios) || windows
+
+package system
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func withStateDir(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	prev := jetboxStateDir
+	jetboxStateDir = func() string { return dir }
+	jetboxDeviceNameMu.Lock()
+	jetboxDeviceName, jetboxDeviceNameLoaded = "", false
+	jetboxDeviceNameMu.Unlock()
+	t.Cleanup(func() {
+		jetboxStateDir = prev
+		jetboxDeviceNameMu.Lock()
+		jetboxDeviceName, jetboxDeviceNameLoaded = "", false
+		jetboxDeviceNameMu.Unlock()
+	})
+	return dir
+}
+
+// Системное имя компьютера в метаданные не попадает — без имени от приложения уходит «JetBox».
+func TestJetboxNoSystemHostname(t *testing.T) {
+	withStateDir(t)
+	sys, _ := os.Hostname()
+	got := GetInfo(context.Background()).Hostname
+	assert.Equal(t, jetboxFallbackDeviceName, got)
+	if sys != "" {
+		assert.NotContains(t, strings.ToLower(got), strings.ToLower(strings.TrimSuffix(sys, ".local")))
+	}
+}
+
+// Имя из Login/Up запоминается и переживает перезапуск службы (читается из каталога состояния).
+func TestJetboxDeviceNamePersists(t *testing.T) {
+	withStateDir(t)
+	SetDeviceName("  Компьютер Ивана  ")
+	assert.Equal(t, "Компьютер Ивана", GetInfo(context.Background()).Hostname)
+
+	// «Перезапуск»: память сброшена, файл остался.
+	jetboxDeviceNameMu.Lock()
+	jetboxDeviceName, jetboxDeviceNameLoaded = "", false
+	jetboxDeviceNameMu.Unlock()
+	assert.Equal(t, "Компьютер Ивана", GetInfo(context.Background()).Hostname)
+
+	// Имя из контекста вызова (Login/Up) — главнее запомненного.
+	ctx := context.WithValue(context.Background(), DeviceNameCtxKey, "Другое имя")
+	require.Equal(t, "Другое имя", GetInfo(ctx).Hostname)
+}
