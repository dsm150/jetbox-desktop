<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Автозапуск приложения JetBox при входе пользователя (LaunchAgent, каждый пользователь Mac).
  `--autostart` — приложение стартует только значком в строке меню, без окна; само себе
  Login Item оно не регистрирует (договорённость с app/). @EXEC@ подставляет build-pkg.sh
  из CFBundleExecutable приложения.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.jet-net.jetbox.desktop</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/JetBox.app/Contents/MacOS/@EXEC@</string>
		<string>--autostart</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
